# Kopitar NHL Analytics Platform - Environment Variables
# Copy this file to .env and update with your actual values

# Database Configuration
DATABASE_URL=postgresql://kopitar_user:kopitar_pass@localhost:5432/kopitar_nhl
POSTGRES_DB=kopitar_nhl
POSTGRES_USER=kopitar_user
POSTGRES_PASSWORD=kopitar_pass

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# InfluxDB Configuration
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=kopitar_super_secret_admin_token
INFLUXDB_ORG=kopitar_org
INFLUXDB_BUCKET=nhl_metrics

# NHL API Configuration
NHL_API_BASE_URL=https://statsapi.web.nhl.com/api/v1
NHL_API_RATE_LIMIT=100
NHL_API_TIMEOUT=30

# External APIs
HOCKEY_REFERENCE_BASE_URL=https://www.hockey-reference.com
NATURAL_STAT_TRICK_URL=https://www.naturalstattrick.com

# Application Configuration
DEBUG=True
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Security
SECRET_KEY=your_super_secret_key_here_please_change_this
JWT_SECRET_KEY=your_jwt_secret_key_here_please_change_this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Airflow Configuration
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__WEBSERVER__SECRET_KEY=airflow_secret_key_please_change_this

# Monitoring & Logging
SENTRY_DSN=your_sentry_dsn_here
PROMETHEUS_PORT=9090

# File Paths
DATA_PATH=./data
MODELS_PATH=./models
LOGS_PATH=./logs
CACHE_PATH=./cache

# Processing Configuration
MAX_WORKERS=4
BATCH_SIZE=1000
PARALLEL_REQUESTS=10

# Development Settings
JUPYTER_PORT=8888
GRAFANA_PORT=3000
AIRFLOW_PORT=8080

# Cloud Storage (Optional)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET_NAME=kopitar-data

GCP_PROJECT_ID=your_gcp_project
GCP_BUCKET_NAME=kopitar-gcp-data

# Advanced Configuration
ENABLE_PROFILING=False
ENABLE_METRICS_COLLECTION=True
CACHE_TTL_SECONDS=300
MAX_MEMORY_USAGE_MB=8192